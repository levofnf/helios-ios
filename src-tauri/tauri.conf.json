{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Helios",
  "version": "0.1.0",
  "identifier": "com.helios.iosport",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [{ "title": "Helios", "width": 390, "height": 844 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
